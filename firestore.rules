rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "REPLACE_WITH_ADMIN_UID";
    }

    // Public can read display settings. Only the configured admin can edit them.
    match /site/{document} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Visitors can create a booking, but cannot list/read/update/delete bookings.
    // Admin can manage bookings. A production deployment should add stronger
    // validation/rate limiting and consider a server-side booking endpoint to
    // prevent malicious clients from creating fake or duplicate reservations.
    match /bookings/{bookingId} {
      allow create: if
        request.resource.data.keys().hasAll([
          "name", "phone", "serviceName", "price", "date", "time", "status", "createdAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 8
        && request.resource.data.phone.size() <= 20
        && request.resource.data.serviceName is string
        && request.resource.data.serviceName.size() <= 100
        && request.resource.data.price is number
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.status == "booked";
      allow read, update, delete: if isAdmin();
    }
  }
}
